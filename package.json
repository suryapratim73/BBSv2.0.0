{
  "name": "bbs",
  "version": "2.23.2",
  "description": "Business management application",
  "main": "main.js",
  "scripts": {
    "bbsDev": "nodemon --exec electron .",
    "build_linux": "electron-builder -l",
    "build_win": "electron-builder -w",
    "prebuild": "node scripts/fetch_python.js win32 linux",
    "prebuild_win": "node scripts/fetch_python.js win32",
    "prebuild_linux": "node scripts/fetch_python.js linux",
    "build": "electron-builder -wl",
    "test": "jest",
    "test:unit": "jest",
    "test:e2e": "playwright test",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "win": {
    "icon": "./logo.png"
  },
  "nodemonConfig": {
    "ignore": [
      "config/*.json",
      "*.json"
    ]
  },
  "author": "Surya Pratim Paul <surya.shilpi22@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@electron/remote": "^2.1.2",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.8",
    "bcrypt": "^5.1.0",
    "dotenv": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "keytar": "^7.9.0",
    "pdfjs-dist": "^3.11.174",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.0",
    "sequelize": "^6.13.0",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.1",
    "uuid": "^8.3.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "electron": "^31.0.1",
    "electron-builder": "^24.13.3",
    "electron-icon-builder": "^2.0.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mbtccodemint.bbs",
    "productName": "Bigbyte Business Service",
    "executableName": "BBS",
    "copyright": "Copyright © 2026 Codemint",
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "python-env/linux",
          "to": "python-env"
        }
      ],
      "category": "Office",
      "icon": "./logo256.png",
      "publish": [
        {
          "provider": "generic",
          "url": "https://code.mbtcverse.com/os/linux/",
          "publishAutoUpdate": true
        }
      ]
    },
    "deb": {
      "fpm": [
        "--after-upgrade=updator.sh"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "python-env/win32",
          "to": "python-env"
        }
      ],
      "publisherName": "Codemint",
      "icon": "./logo256.png"
    },
    "nsis": {
      "oneClick": true,
      "allowElevation": true,
      "runAfterFinish": true,
      "shortcutName": "BBS",
      "allowToChangeInstallationDirectory": false
    },
    "compression": "store",
    "files": [
      "!test.js",
      "!todo",
      "!window-state.json",
      "!electron-builder.env",
      "!.gitignore",
      "!private",
      "!logs/",
      "!ext/",
      "!db/",
      "!config/",
      "!.vscode",
      "!updtConf.json",
      "!changelog.json",
      "!model/*.json",
      "!__tests__/**",
      "!__mocks__/**",
      "!e2e/**",
      "!coverage/**",
      "!test-results/**",
      "!playwright-report/**",
      "!jest.config.js",
      "!playwright.config.js",
      "!python-env/"
    ],
    "asar": false
  },
  "homepage": "https://code.mbtcverse.com/"
}
