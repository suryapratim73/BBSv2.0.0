{
  "name": "bbs",
  "version": "2.1.14",
  "description": "Business management application",
  "main": "main.js",
  "scripts": {
    "bbsDev": "nodemon --ignore 'config/*.json' --ignore '*.json' --exec electron .",
    "build": "electron-builder -l"
  },
  "author": "Surya Pratim Paul <surya.shilpi22@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.1.3",
    "bcrypt": "^5.0.1",
    "dotenv": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "pdfkit": "^0.12.1",
    "qrcode": "^1.5.0",
    "sequelize": "^6.13.0",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^23.3.3",
    "nodemon": "^2.0.20"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mbtccodemint.bbs",
    "productName": "Bigbyte Business Service",
    "executableName": "BBS",
    "copyright": "Copyright © year Codemint",
    "linux": {
      "target": "deb",
      "category": "Office",
      "publish": [
        {
          "provider": "generic",
          "url": "http://192.168.0.104:3030/os/linux/",
          "publishAutoUpdate": true
        }
      ]
    },
    "deb":{
      "fpm":["--after-upgrade=updator.sh"]
    },
    "compression": "store",
    "files": [
      "!test.js",
      "!todo",
      "!window-state.json",
      "!electron-builder.env",
      "!.gitignore",
      "!private",
      "!logs",
      "!ext",
      "!db/",
      "!config",
      "!.vscode"
    ],
    "asar":false,
    "afterPack":"scripts/afterpack.js"
  },
  "homepage": "http://192.168.0.104:/home/git/BBS.git"
}
