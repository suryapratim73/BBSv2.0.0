{
  "name": "bbs",
  "version": "2.10.23",
  "description": "Business management application",
  "main": "main.js",
  "scripts": {
    "bbsDev": "nodemon --exec electron .",
    "build_linux": "electron-builder -l",
    "build_win": "electron-builder -w",
    "build": "electron-builder -wl"
  },
  "nodemonConfig": {
    "ignore": [
      "config/*.json",
      "*.json"
    ]
  },
  "author": "Surya Pratim Paul <surya.shilpi22@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "adm-zip": "^0.5.10",
    "axios": "^1.1.3",
    "bcrypt": "^5.1.0",
    "dotenv": "^8.2.0",
    "electron-window-state": "^5.0.3",
    "pdfkit": "^0.12.1",
    "qrcode": "^1.5.0",
    "sequelize": "^6.13.0",
    "speakeasy": "^2.0.0",
    "sqlite3": "^5.1.1",
    "uuid": "^8.3.2"
  },
  "devDependencies": {
    "electron": "^11.5.0",
    "electron-builder": "^23.6.0",
    "nodemon": "^2.0.22"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "build": {
    "appId": "com.mbtccodemint.bbs",
    "productName": "Bigbyte Business Service",
    "executableName": "BBS",
    "copyright": "Copyright © year Codemint",
    "nodeVersion":"16.20.2",
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "publish": [
        {
          "provider": "generic",
          "url": "http://192.168.0.104:3030/os/linux/",
          "publishAutoUpdate": true
        }
      ]
    },
    "deb": {
      "fpm": [
        "--after-upgrade=test.sh"
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "publisherName": "Codemint"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "runAfterFinish": true,
      "shortcutName": "BBS",
      "allowToChangeInstallationDirectory": true
    },
    "compression": "store",
    "files": [
      "!test.js",
      "!todo",
      "!window-state.json",
      "!electron-builder.env",
      "!.gitignore",
      "!private",
      "!logs/",
      "!ext/",
      "!db/",
      "!config/",
      "!.vscode"
    ],
    "asar": false,
    "afterPack": "scripts/afterpack.js"
  },
  "homepage": "http://192.168.0.111/home/git/BBS.git"
}
